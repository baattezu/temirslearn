{
  "name": "temirslearn",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply temirslearn --remote",
    "db:migrate:local": "wrangler d1 migrations apply temirslearn --local",
