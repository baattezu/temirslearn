    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.44.0",
    "@mdx-js/react": "^3.1.1",
    "@uiw/react-codemirror": "^4.25.13",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.22",
    "katex": "^0.19.1",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.3",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
